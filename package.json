{
  "name": "vault-books-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API de catalogue de livres pour Vault Read : recherche triée, sagas dans l'ordre, couvertures fiables.",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "contrat": "node scripts/contrat.mjs",
    "dev": "node --env-file=.env scripts/dev-server.mjs",
    "test": "node --test test/",
    "test:c": "node --env-file=.env scripts/test-c.mjs",
    "corriger": "node --env-file=.env scripts/corriger.mjs",
    "pertinence": "node --env-file=.env scripts/pertinence.mjs",
    "sauvegarder": "node --env-file=.env scripts/exporter-corrections.mjs",
    "mesure-couvertures": "node --env-file=.env scripts/mesure-couvertures.mjs",
    "mesure-resumes": "node --env-file=.env scripts/mesure-resumes.mjs",
    "proposer-noms": "node --env-file=.env scripts/proposer-noms-sagas.mjs",
    "importer-noms": "node --env-file=.env scripts/importer-noms.mjs",
    "planche": "node --env-file=.env scripts/planche-sagas.mjs",
    "verifier:supabase": "node --env-file=.env scripts/verifier-supabase.mjs",
    "smoke": "node --env-file=.env scripts/smoke.mjs"
  }
}

